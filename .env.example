# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit credentials.
# ------------------------------------------------------------------

# PostgreSQL (must have the pgvector extension available).
# Matches docker-compose.yml. For a cloud DB add ?sslmode=require
DATABASE_URL=postgresql://placement:placement_dev_password@localhost:5432/placement_portal
# Host port used by docker-compose.yml (keep in sync with the port in DATABASE_URL)
DB_PORT=5432

# Secret used to sign session cookies (JWT, HS256). Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# Placement officer account created by `npm run db:seed`
ADMIN_EMAIL=placement.officer@university.edu
ADMIN_PASSWORD=ChangeMe@123

# Password given to every demo student / recruiter created by the seed script
SEED_DEMO_PASSWORD=Password@123

# ---------------- Embeddings ----------------
# local  -> all-MiniLM-L6-v2 runs inside Node via transformers.js (free, offline after first download)
# openai -> OpenAI text-embedding-3-small (requests 384 dimensions to fit the same schema)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Where the local model files are cached (optional)
TRANSFORMERS_CACHE_DIR=./.cache/transformers

# Time zone used to display dates and times
APP_TIMEZONE=Asia/Kolkata

# Set to true only when the app is served over HTTPS
COOKIE_SECURE=false
